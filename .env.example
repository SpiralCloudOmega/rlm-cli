# Frontier-only model selection (GPT >= 5.6, Claude Fable >= 5, or Kimi K >= 3)

# GPT-5.6 Sol
# RLM_MODEL=gpt-5.6-sol
# OPENAI_API_KEY=...

# Claude Fable 5
# RLM_MODEL=claude-fable-5
# ANTHROPIC_API_KEY=sk-ant-...

# Kimi K3 as an OpenAI-compatible sub-model
# RLM_SUB_MODEL=kimi-k3
# RLM_SUB_API_KEY=...
# RLM_SUB_BASE_URL=https://api.moonshot.ai/v1

# Optional metadata for custom endpoints
# RLM_SUB_CONTEXT_WINDOW=262144
# RLM_SUB_MAX_OUTPUT_TOKENS=8192
# RLM_SUB_INPUT_COST_PER_M=0
# RLM_SUB_OUTPUT_COST_PER_M=0
